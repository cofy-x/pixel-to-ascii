{
  "name": "@cofy-x/pixel-to-ascii",
  "version": "0.1.0",
  "description": "A lightweight, high-fidelity TypeScript library and CLI tool to convert images into ASCII art using ANSI TrueColor.",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "pixa": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:demo": "tsx examples/demo.ts",
    "dev:cli": "tsx src/cli.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:fix:format": "pnpm run lint:fix && pnpm run format",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run test && pnpm run build && pnpm run package:check",
    "package:check": "publint && attw --pack --profile esm-only . && node ./scripts/verify-package.mjs",
    "prepack": "pnpm run build",
    "format": "prettier --experimental-cli --write .",
    "cli:link": "pnpm run build && npm link",
    "cli:unlink": "npm unlink -g @cofy-x/pixel-to-ascii"
  },
  "keywords": [
    "ascii",
    "ansi",
    "ascii-art",
    "image",
    "image-processing",
    "cli",
    "terminal",
    "truecolor",
    "nodejs",
    "typescript"
  ],
  "author": "wayne <rcywjo@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/cofy-x/pixel-to-ascii#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cofy-x/pixel-to-ascii.git"
  },
  "bugs": {
    "url": "https://github.com/cofy-x/pixel-to-ascii/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "jimp": "^1.6.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-license-header": "^0.9.0",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
